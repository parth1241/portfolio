<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>

  <main class="skills-page">
    <!-- Animated Grid Background -->
    <div class="digital-grid"></div>

    <div class="container" style="position: relative; z-index: 2;">
      <div style="text-align: center; margin-bottom: 60px;">
        <span class="section-tag">// TECH STACK</span>
        <h1 style="font-size: 3.5rem;">Neural <span class="accent">Architecture</span></h1>
        <p style="color: var(--text-dim); max-width: 600px; margin: 20px auto;">Integrating high-performance hardware logic with decentralized blockchain infrastructure.</p>
      </div>

      <!-- 3D Orbit Ring -->
      <section class="orbit-section reveal">
        <div class="orbit-container">
          <div class="orbit-core">
            <div class="core-inner">CORE</div>
            <div class="core-glow"></div>
          </div>
          
          <% 
            const skills = [
              { name: 'python', color: '#3776AB' },
              { name: 'react', color: '#61DAFB' },
              { name: 'nextdotjs', color: '#ffffff' },
              { name: 'nodedotjs', color: '#339933' },
              { name: 'docker', color: '#2496ED' },
              { name: 'git', color: '#F05032' },
              { name: 'linux', color: '#FCC624' },
              { name: 'stellar', color: '#000000' }
            ];
            
            skills.forEach((skill, index) => { 
              const angle = (360 / skills.length) * index;
          %>
            <div class="orbit-item" style="transform: rotateY(<%= angle %>deg) translateZ(320px);">
              <div class="skill-icon-card js-skill-card" style="--brand-color: <%= skill.color %>">
                <div class="icon-3d-wrap js-3d-icon" data-color="<%= skill.color %>">
                  <img src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/<%= skill.name %>.svg" alt="<%= skill.name %>">
                </div>
                <span class="skill-name"><%= skill.name.toUpperCase() %></span>
              </div>
            </div>
          <% }); %>
        </div>
      </section>

      <!-- System Manifest: Detailed Descriptions -->
      <section class="manifest-section reveal">
        <h3 class="scanner-title">// SYSTEM MANIFEST</h3>
        <div class="manifest-grid">
          <% 
            const details = [
              { name: 'Python', desc: 'Scalable automation, backend scripting, and high-performance data engineering.', icon: 'python' },
              { name: 'React', desc: 'Modern UI/UX development with sophisticated state management and interactive components.', icon: 'react' },
              { name: 'Next.js', desc: 'Full-stack application architecture with SEO-optimized server-side rendering.', icon: 'nextdotjs' },
              { name: 'Node.js', desc: 'Building robust, event-driven backend services and real-time API infrastructures.', icon: 'nodedotjs' },
              { name: 'Docker', desc: 'Enterprise-grade containerization and streamlined DevOps deployment cycles.', icon: 'docker' },
              { name: 'Git', desc: 'Advanced version control, collaborative workflows, and multi-branch management.', icon: 'git' },
              { name: 'Linux', desc: 'Professional system administration and high-security server environment management.', icon: 'linux' },
              { name: 'Stellar', desc: 'Blockchain protocol integration and decentralized financial application development.', icon: 'stellar' }
            ];
            details.forEach(item => {
          %>
            <div class="manifest-card glass">
              <div class="manifest-header">
                <img src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/<%= item.icon %>.svg" alt="<%= item.name %>">
                <h4><%= item.name %></h4>
              </div>
              <p><%= item.desc %></p>
            </div>
          <% }); %>
        </div>
      </section>
      <section class="scanners-section reveal">
        <div class="scanner-grid">
          <div class="scanner-column">
            <h3 class="scanner-title">// CORE ENGINE</h3>
            <div class="proficiency-scanners">
              <% [
                { s: 'Python / Automation', p: 95 },
                { s: 'React / Next.js', p: 90 },
                { s: 'Node.js / Express', p: 85 },
                { s: 'Docker / DevOps', p: 80 }
              ].forEach(item => { %>
                <div class="scanner-item">
                  <div class="scanner-label">
                    <span><%= item.s %></span>
                    <span><%= item.p %>%</span>
                  </div>
                  <div class="scanner-bar-wrap">
                    <div class="scanner-bar" style="--percent: <%= item.p %>%"></div>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>

          <div class="scanner-column">
            <h3 class="scanner-title">// DECENTRALIZED STACK</h3>
            <div class="proficiency-scanners">
              <% [
                { s: 'Stellar Blockchain', p: 88 },
                { s: 'Smart Contracts', p: 82 },
                { s: 'Web3 Architecture', p: 85 },
                { s: 'Security Auditing', p: 75 }
              ].forEach(item => { %>
                <div class="scanner-item">
                  <div class="scanner-label">
                    <span><%= item.s %></span>
                    <span><%= item.p %>%</span>
                  </div>
                  <div class="scanner-bar-wrap">
                    <div class="scanner-bar" style="--percent: <%= item.p %>%"></div>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      </section>

      <!-- System Terminal -->
      <section class="terminal-section reveal">
        <div class="system-terminal">
          <div class="terminal-header">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
            <span class="terminal-title">DIAGNOSTIC_CONSOLE.SH</span>
          </div>
          <div class="terminal-body" id="terminal-output">
            <p>> INITIALIZING SYSTEM SCAN...</p>
            <p>> HARDWARE INTERFACE: OPTIMIZED</p>
            <p>> BLOCKCHAIN CONNECTIVITY: SECURE</p>
            <p>> STACK INTEGRITY: 100%</p>
            <p class="blink">> SYSTEM READY_</p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Anime.js 3D Icon Rotation Logic
      anime({
        targets: '.js-3d-icon',
        rotateY: '1turn',
        duration: 3000,
        easing: 'linear',
        loop: true,
        delay: anime.stagger(200)
      });

      // Smooth 3D Orbit using Anime.js for better performance/easing
      // Note: We keep the CSS animation as fallback, but JS can enhance it
      /*
      anime({
        targets: '.orbit-container',
        rotateY: '360deg',
        duration: 30000,
        easing: 'linear',
        loop: true
      });
      */
    });
  </script>
</body>
</html>
